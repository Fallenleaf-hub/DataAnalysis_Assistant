<Window
    x:Class="DataAnalysis_Assistant.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:models="using:DataAnalysis_Assistant.Models"
    Title="DataAnalysis Assistant - AI 数据分析与文档伴读助手">

    <Grid Background="{StaticResource WarmBgBrush}">
        <Grid.ColumnDefinitions>
            <!-- 最左侧极窄导航栏（窄栏 56px） -->
            <ColumnDefinition Width="56"/>
            <!-- 右侧主内容区域（主工作区 / 二级配置界面） -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧导航栏（窄） ==================== -->
        <!-- 参考界面设计：极窄极简、纯图标形态、上图风格与层级结构 -->
        <Border Grid.Column="0" Background="{StaticResource RailBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="0,0,1,0" Padding="0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- 顶部主导航组 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 占位伸缩行 -->
                    <RowDefinition Height="*"/>
                    <!-- 底部：设置与更多 -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶部主导航组（顺序与上图完全一致） -->
                <StackPanel Grid.Row="0" Spacing="10" HorizontalAlignment="Center">
                    <!-- 1. 主页面 / 看板（实心房屋，选中态高亮圆角底框） -->
                    <Button x:Name="btnNavHome" Click="btnNavHome_Click" ToolTipService.ToolTip="主页面看板"
                            Width="40" Height="40" Padding="0" CornerRadius="10"
                            Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                        <Viewbox Width="20" Height="20">
                            <Path x:Name="pathNavHome" Fill="{StaticResource TextPrimaryBrush}"
                                  Data="M 12 3 L 3 11 L 3 20 C 3 20.6 3.4 21 4 21 L 9.5 21 L 9.5 15 C 9.5 13.9 10.6 13 12 13 C 13.4 13 14.5 13.9 14.5 15 L 14.5 21 L 20 21 C 20.6 21 21 20.6 21 20 L 21 11 L 12 3 Z"/>
                        </Viewbox>
                    </Button>

                    <!-- 2. 可视化（双层卡片/画板） -->
                    <Button x:Name="btnNavVis" Click="btnNavVis_Click" ToolTipService.ToolTip="可视化"
                            Width="40" Height="40" Padding="0" CornerRadius="10"
                            Background="Transparent" BorderThickness="0">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <!-- 底层卡片 -->
                                <Path x:Name="pathNavVisBack" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 8 3 H 19 C 20.1 3 21 3.9 21 5 V 15 C 21 16.1 20.1 17 19 17"/>
                                <!-- 顶层卡片 -->
                                <Path x:Name="pathNavVisFront" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 4 7 H 15 C 16.1 7 17 7.9 17 9 V 19 C 17 20.1 16.1 21 15 21 H 4 C 2.9 21 2 20.1 2 19 V 9 C 2 7.9 2.9 7 4 7 Z"/>
                                <!-- 顶层卡片内部：微型太阳与折线山丘 -->
                                <Ellipse x:Name="pathNavVisDot" Fill="{StaticResource TextSecondaryBrush}" Width="2.5" Height="2.5" Canvas.Left="6" Canvas.Top="9.5"/>
                                <Path x:Name="pathNavVisInner" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 4 17 L 7 13 L 10 16 L 12 14 L 15 17"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- 3. 历史会话（时钟） -->
                    <Button x:Name="btnNavHistory" Click="btnNavHistory_Click" ToolTipService.ToolTip="历史对话记录"
                            Width="40" Height="40" Padding="0" CornerRadius="10"
                            Background="Transparent" BorderThickness="0">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="pathNavHistoryCircle" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 12 3 C 7.03 3 3 7.03 3 12 C 3 16.97 7.03 21 12 21 C 16.97 21 21 16.97 21 12 C 21 7.03 16.97 3 12 3 Z"/>
                                <Path x:Name="pathNavHistoryHands" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 12 7 V 12 L 9.5 14.5"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- 4. 文档库（三本书，带动态数字角标） -->
                    <Grid Width="40" Height="40">
                        <Button x:Name="btnNavDocLibrary" Click="btnNavDocLibrary_Click" ToolTipService.ToolTip="文档库"
                                Width="40" Height="40" Padding="0" CornerRadius="10"
                                Background="Transparent" BorderThickness="0">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <!-- 书本 1（左） -->
                                    <Path x:Name="pathNavDoc1" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M 4 5 C 4 4.4 4.4 4 5 4 H 6 C 6.6 4 7 4.4 7 5 V 19 C 7 19.6 6.6 20 6 20 H 5 C 4.4 20 4 19.6 4 19 Z"/>
                                    <!-- 书本 2（中） -->
                                    <Path x:Name="pathNavDoc2" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M 9.5 5 C 9.5 4.4 9.9 4 10.5 4 H 11.5 C 12.1 4 12.5 4.4 12.5 5 V 19 C 12.5 19.6 12.1 20 11.5 20 H 10.5 C 9.9 20 9.5 19.6 9.5 19 Z"/>
                                    <!-- 书本 3（右倾斜） -->
                                    <Path x:Name="pathNavDoc3" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M 15 5.5 L 17.5 4.8 C 18.2 4.6 18.8 5 19 5.7 L 21.8 17.5 C 22 18.2 21.6 18.8 20.9 19 L 18.4 19.7 C 17.7 19.9 17.1 19.5 16.9 18.8 L 14.1 7 C 13.9 6.3 14.3 5.7 15 5.5 Z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <!-- 动态数字角标 -->
                        <Border x:Name="railDocBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Background="{StaticResource AccentWarmBrush}" CornerRadius="7" Padding="4,1" IsHitTestVisible="False">
                            <TextBlock x:Name="tbRailDocBadge" Text="0" FontSize="8" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </Grid>

                    <!-- 5. AI 对话 / @ 助手 -->
                    <Button x:Name="btnNavChat" Click="btnNavChat_Click" ToolTipService.ToolTip="AI 对话助手"
                            Width="40" Height="40" Padding="0" CornerRadius="10"
                            Background="Transparent" BorderThickness="0">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="pathNavChatOuter" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 16 12 C 16 14.2 14.2 16 12 16 C 9.8 16 8 14.2 8 12 C 8 9.8 9.8 8 12 8 C 14.2 8 16 9.8 16 12 Z M 16 9 V 14 C 16 15.1 16.9 16 18 16 C 19.1 16 20 15.1 20 14 V 12 C 20 7.6 16.4 4 12 4 C 7.6 4 4 7.6 4 12 C 4 16.4 7.6 20 12 20 C 14.5 20 16.8 18.8 18.2 17"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>

                <!-- 6. 底部：三点设置与更多 -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                    <Button x:Name="btnNavSettings" Click="btnNavSettings_Click" ToolTipService.ToolTip="设置与更多"
                            Width="40" Height="40" Padding="0" CornerRadius="10"
                            Background="Transparent" BorderThickness="0">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Ellipse x:Name="pathNavSettingsDot1" Fill="{StaticResource TextSecondaryBrush}" Width="3.2" Height="3.2" Canvas.Left="4.5" Canvas.Top="10.4"/>
                                <Ellipse x:Name="pathNavSettingsDot2" Fill="{StaticResource TextSecondaryBrush}" Width="3.2" Height="3.2" Canvas.Left="10.4" Canvas.Top="10.4"/>
                                <Ellipse x:Name="pathNavSettingsDot3" Fill="{StaticResource TextSecondaryBrush}" Width="3.2" Height="3.2" Canvas.Left="16.3" Canvas.Top="10.4"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 右侧内容承载区 ==================== -->
        <Grid Grid.Column="1">
            <!-- 界面 1：主工作区 (包含文档提取看板、AI对话以及左侧弹出文档库/历史会话) -->
            <Grid x:Name="gridMainWorkspace" Visibility="Visible">
                <!-- 主内容区：双栏弹性布局（左：中间板块，右：AI 智能对话） -->
                <Grid Margin="10,10,12,12">
                        <Grid.ColumnDefinitions>
                            <!-- 中间板块（文档预览 + 可视化界面） -->
                            <ColumnDefinition Width="*" MinWidth="420"/>
                            <!-- 右侧对话板块 -->
                            <ColumnDefinition Width="460" MinWidth="380" MaxWidth="600"/>
                        </Grid.ColumnDefinitions>

                        <!-- ==================== 中间板块 ==================== -->
                        <Border Grid.Column="0" Margin="0,0,6,0" Background="{StaticResource WarmBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" CornerRadius="14" Padding="16,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- 中间板块顶部：两个窄选项卡（文档预览板块 / 可视化界面） -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- 内容切换承载区 -->
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 【中间板块顶部两个选项卡（窄）】 -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 左侧操作组：【选择文件】按钮 + 选项卡胶囊选择器 -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <!-- 【选择文件】独立按钮 (位于【文档预览】左侧) -->
                                        <Button x:Name="btnHeaderSelectFile" Click="btnSelectFile_Click" Height="34" Padding="12,0" Background="{StaticResource AccentWarmBrush}" Foreground="White" CornerRadius="8" ToolTipService.ToolTip="选择本地文档 (支持 PDF/Word/Excel/TXT/CSV/MD)">
                                            <TextBlock Text="选择文件" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                        </Button>

                                        <!-- 紧凑型胶囊选项卡选择器（高度窄 34px） -->
                                        <Border Background="#E5DEC9" CornerRadius="8" Padding="2" Height="34">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <!-- 选项卡 1：文档预览板块 -->
                                                <Button x:Name="btnTabDocPreview" Click="btnTabDocPreview_Click" Padding="12,4" Height="28" CornerRadius="6" Background="{StaticResource CardBgBrush}" BorderThickness="0">
                                                    <TextBlock x:Name="tbTabPreviewTitle" Text="文档预览" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                </Button>

                                                <!-- 选项卡 2：可视化界面 -->
                                                <Button x:Name="btnTabVisualization" Click="btnTabVisualization_Click" Padding="12,4" Height="28" CornerRadius="6" Background="Transparent" BorderThickness="0">
                                                    <TextBlock x:Name="tbTabVisTitle" Text="可视化" FontSize="12" FontWeight="Normal" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- 标题与状态提示 -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="tbPreviewDocTitle" Text="未选中文档" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <Border x:Name="borderDocBadge" Background="#D5CBB8" CornerRadius="6" Padding="6,2" VerticalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock x:Name="tbDocBadgeText" Text="TXT" FontSize="10" FontWeight="Bold" Foreground="#382E24"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- 快速操作按钮 -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button x:Name="btnCopyPreview" Click="btnCopyPreview_Click" Content="复制文本" Padding="10,5" CornerRadius="8" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" FontSize="11"/>
                                        <Button x:Name="btnClearPreview" Click="btnClearPreview_Click" Content="清空" Padding="10,5" CornerRadius="8" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" FontSize="11"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 视图 1：文档预览板块 (gridDocPreviewView) -->
                                <Grid x:Name="gridDocPreviewView" Grid.Row="1" Visibility="Visible">
                                    <Grid.RowDefinitions>
                                        <!-- 4 核心统计指标卡片栏 -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- 核心文本提取大卡片 -->
                                        <RowDefinition Height="*"/>
                                        <!-- 底部说明栏 -->
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 统计指标卡片 -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" CornerRadius="12" Padding="12,10" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="文档格式" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock x:Name="tbStatFileType" Text="--" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentWarmBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Background="{StaticResource CardBgBrush}" CornerRadius="12" Padding="12,10" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="文件大小" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock x:Name="tbStatFileSize" Text="0 KB" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="{StaticResource CardBgBrush}" CornerRadius="12" Padding="12,10" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="提取字数 (Chars)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock x:Name="tbStatCharCount" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="3" Background="{StaticResource CardBgBrush}" CornerRadius="12" Padding="12,10" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="预估 Token 占用" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock x:Name="tbStatTokenCount" Text="~0" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- 核心提取文本预览卡片 -->
                                    <Border Grid.Row="1" Background="{StaticResource CardBgBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" Padding="14">
                                        <Grid>
                                            <!-- 空内容引导 -->
                                            <StackPanel x:Name="spEmptyPreview" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Visibility="Visible">
                                                <TextBlock Text="暂无文档文本内容" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="请在左侧导航栏点击【文档库】选择本地文档立即预览文本，&#x0a;或在后续阶段通过解析引擎提取 PDF / Word / Excel。" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                            </StackPanel>

                                            <!-- 多行只读预览框 -->
                                            <TextBox x:Name="tbPreviewContent" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" CornerRadius="8" FontSize="13" FontFamily="Consolas, Cascadia Code, PingFang SC, Microsoft YaHei" Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>

                                    <!-- 底部提示信息条 -->
                                    <Border Grid.Row="2" Margin="0,8,0,0" Padding="10,6" Background="{StaticResource SidebarBgBrush}" CornerRadius="8">
                                        <TextBlock Text="文档就绪后，在右侧对话框提问，AI 生成的数据图表将自动呈现在上方【可视化界面】中。" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- 视图 2：可视化界面板块 (gridVisualizationView - 动态 AI 图表分析看板与画廊) -->
                                <Grid x:Name="gridVisualizationView" Grid.Row="1" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <!-- 图表汇总看板指标条 -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- 图表主渲染卡片与画廊 -->
                                        <RowDefinition Height="*"/>
                                        <!-- 底部操作与洞察结论条 -->
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 1. AI 图表统计指标条 -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" CornerRadius="12" Padding="12,10" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="已生成图表资产" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock x:Name="tbVisTotalPlots" Text="0 幅图表" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentWarmBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Background="{StaticResource CardBgBrush}" CornerRadius="12" Padding="12,10" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="当前激活看板图表" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock x:Name="tbVisActivePlotTitle" Text="暂无激活图表" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="{StaticResource CardBgBrush}" CornerRadius="12" Padding="12,10" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="最新生成时间" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock x:Name="tbVisLatestPlotTime" Text="--" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- 2. 图表主渲染容器卡片 (支持空状态与画廊切换) -->
                                    <Border Grid.Row="1" Background="{StaticResource CardBgBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" Padding="16">
                                        <Grid>
                                            <!-- 空状态引导提示 -->
                                            <StackPanel x:Name="spEmptyVisGallery" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Visibility="Visible">
                                                <Border Background="#E8E2D5" Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center">
                                                    <TextBlock Text="📊" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="暂无生成的数据可视化图表" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="在右侧对话框中提出数据统计需求（例如：'统计各类别占比并绘制柱状图'），&#x0a;AI 编写并执行 Python 脚本后，生成的矢量图表将就地内嵌并沉淀至本看板。" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="440" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
                                                    <Button x:Name="btnGenerateDemoPlot" Click="btnGenerateDemoPlot_Click" Content="生成示例数据分析图表" Padding="14,6" CornerRadius="8" Background="{StaticResource AccentWarmBrush}" Foreground="White" FontSize="12"/>
                                                    <Button Click="btnOpenPlotFolder_Click" Content="打开图表缓存目录" Padding="14,6" CornerRadius="8" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" FontSize="12"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- 真实图表主展示内容 (有图表时显示) -->
                                            <Grid x:Name="gridActivePlotContent" Visibility="Collapsed">
                                                <Grid.RowDefinitions>
                                                    <!-- 标题栏与控制按钮 -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- 主大图渲染区 -->
                                                    <RowDefinition Height="*"/>
                                                    <!-- 下方图表画廊缩略图列表 -->
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- 标题与操作栏 -->
                                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <TextBlock x:Name="tbActivePlotHeader" Text="数据可视化大屏展示" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <Border Background="#EAE5DA" CornerRadius="6" Padding="6,2">
                                                            <TextBlock x:Name="tbActivePlotMeta" Text="高清 PNG" FontSize="10" Foreground="{StaticResource AccentWarmBrush}" FontWeight="Medium"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                        <Button Click="btnExportDashboardReport_Click" Content="📄 导出研报" Padding="10,4" CornerRadius="6" Background="{StaticResource AccentWarmBrush}" Foreground="White" FontSize="11" ToolTipService.ToolTip="将当前看板激活图表与数据结论导出为专业 Word 或 Markdown 研报"/>
                                                        <Button Click="btnActivePlotZoom_Click" Content="🔍 放大" Padding="10,4" CornerRadius="6" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" FontSize="11" ToolTipService.ToolTip="全屏放大查看当前图表"/>
                                                        <Button Click="btnActivePlotCopy_Click" Content="📋 复制" Padding="10,4" CornerRadius="6" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" FontSize="11" ToolTipService.ToolTip="复制当前图表到剪贴板"/>
                                                        <Button Click="btnActivePlotSave_Click" Content="💾 另存为" Padding="10,4" CornerRadius="6" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" FontSize="11" ToolTipService.ToolTip="将当前图表另存为本地文件"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- 主大图展示区 (可点击放大) -->
                                                <Border Grid.Row="1" CornerRadius="10" Background="#FBF9F4" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,10" PointerPressed="imgActiveDashboardPlot_PointerPressed" ToolTipService.ToolTip="点击全屏放大查看">
                                                    <Image x:Name="imgActiveDashboardPlot" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- 底部历史图表画廊缩略图水平滚动栏 (Gallery) -->
                                                <Grid Grid.Row="2">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="图表历史画廊 (点击切换主视图)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                                                    <ListView Grid.Row="1" x:Name="lvPlotGallery" ItemsSource="{x:Bind PlotGallery}" SelectionChanged="lvPlotGallery_SelectionChanged" SelectionMode="Single" Height="76">
                                                        <ListView.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="8"/>
                                                            </ItemsPanelTemplate>
                                                        </ListView.ItemsPanel>
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate x:DataType="models:ChartArtifactItem">
                                                                <Border Width="110" Height="68" CornerRadius="8" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" Padding="4" ToolTipService.ToolTip="{x:Bind Title}">
                                                                    <Grid>
                                                                        <Image Source="{x:Bind Bitmap}" Stretch="UniformToFill" HorizontalAlignment="Center"/>
                                                                        <Border VerticalAlignment="Bottom" Background="#80000000" CornerRadius="0,0,7,7" Padding="4,2">
                                                                            <TextBlock Text="{x:Bind Title}" FontSize="9" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- 3. AI 洞察分析与状态操作条 -->
                                    <Border Grid.Row="2" Margin="0,8,0,0" Padding="12,8" Background="{StaticResource SidebarBgBrush}" CornerRadius="8">
                                        <Grid>
                                            <TextBlock x:Name="tbVisInsightTip" Text="AI 洞察：图表已根据分析代码由本地 Python 引擎完成矢量演算与渲染，支持右键或另存为高清导出。" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                <Button Click="btnExportDashboardReport_Click" Content="📄 导出看板研报" Padding="10,4" CornerRadius="6" Background="Transparent" BorderThickness="0" FontSize="11" Foreground="{StaticResource AccentWarmBrush}"/>
                                                <Button Click="btnOpenPlotFolder_Click" Content="打开图表文件夹" Padding="10,4" CornerRadius="6" Background="Transparent" BorderThickness="0" FontSize="11" Foreground="{StaticResource AccentWarmBrush}"/>
                                                <Button Click="btnClearPlotGallery_Click" Content="清空画廊" Padding="10,4" CornerRadius="6" Background="Transparent" BorderThickness="0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ==================== 右侧对话板块 ==================== -->
                        <Border Grid.Column="1" Margin="6,0,0,0" Background="{StaticResource CardSubtleBrush}" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" CornerRadius="14">
                            <Grid Margin="14,14,14,12">
                                <Grid.RowDefinitions>
                                    <!-- 对话头部 -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- 消息展示流 (Markdown 渲染) -->
                                    <RowDefinition Height="*"/>
                                    <!-- 快捷问题提示词 Pills -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- 输入框与发送区 (模型选择放置在发送按钮左侧) -->
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 对话头部 -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="AI 智能伴读与分析" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="btnClearChat" Click="btnClearChat_Click" Content="清空" Padding="10,4" CornerRadius="8" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" FontSize="11"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 对话展示区 (带 Markdown 渲染) -->
                                <ScrollViewer x:Name="svChatList" Grid.Row="1" Margin="0,0,0,8" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="icChatMessages">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:ChatMessageItem">
                                                <Grid Margin="0,6">
                                                    <!-- 用户气泡 (靠右圆润设计) -->
                                                    <StackPanel Visibility="{x:Bind UserBubbleVisibility, Mode=OneWay}" HorizontalAlignment="Right" MaxWidth="380" Spacing="3">
                                                        <TextBlock Text="{x:Bind FormattedTime, Mode=OneWay}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                                        <Border Background="{StaticResource UserBubbleBrush}" CornerRadius="16,4,16,16" Padding="12,9" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                                                            <TextBlock Text="{x:Bind Content, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="13"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- AI 助手气泡 (靠左圆润设计，支持思考过程折叠与 Markdown 渲染) -->
                                                    <StackPanel Visibility="{x:Bind AssistantBubbleVisibility, Mode=OneWay}" HorizontalAlignment="Left" MaxWidth="410" Spacing="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="AI 助手" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentWarmBrush}"/>
                                                            <TextBlock Text="{x:Bind FormattedTime, Mode=OneWay}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </StackPanel>

                                                        <!-- 思考过程独立折叠卡片 (仅当有思考内容时显示) -->
                                                        <Border Visibility="{x:Bind HasReasoningVisibility, Mode=OneWay}" Background="#F0EDE4" CornerRadius="8" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" Padding="8,6" Margin="0,0,0,2">
                                                            <StackPanel Spacing="6">
                                                                <!-- 思考状态头部条 (点击可自由展开/收起) -->
                                                                <Button Click="btnToggleReasoning_Click" Tag="{x:Bind}" Background="Transparent" BorderThickness="0" Padding="2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                                    <Grid>
                                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                            <!-- 微型动态加载圆环 (仅思考中显示) -->
                                                                            <ProgressRing Visibility="{x:Bind ThinkingIndicatorVisibility, Mode=OneWay}" IsActive="True" Width="12" Height="12" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{x:Bind ThinkingStatusText, Mode=OneWay}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                        <!-- 右侧展开/收起文字 -->
                                                                        <TextBlock Text="{x:Bind ReasoningToggleText, Mode=OneWay}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </Button>

                                                                <!-- 思考过程具体内容 (展开时可见) -->
                                                                <Border Visibility="{x:Bind ReasoningBodyVisibility, Mode=OneWay}" Background="#EAE5D9" CornerRadius="6" Padding="8,6">
                                                                    <TextBlock Text="{x:Bind ReasoningDisplayText, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="PingFang SC, Microsoft YaHei, Segoe UI"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- 正式回答卡片 (Markdown 渲染) -->
                                                        <Border Background="{StaticResource CardBgBrush}" CornerRadius="4,16,16,16" Padding="14,12" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                                                            <StackPanel Spacing="8">
                                                                <controls:MarkdownTextBlock Text="{x:Bind Content, Mode=OneWay}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Background="Transparent"/>
                                                                
                                                                <!-- 手动停止生成提示 -->
                                                                <TextBlock Visibility="{x:Bind StoppedNoticeVisibility, Mode=OneWay}" Text="(已停止生成)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"/>

                                                                <!-- 生成图表多模态呈现容器 -->
                                                                <ItemsControl ItemsSource="{x:Bind GeneratedPlots}" Visibility="{x:Bind HasPlotsVisibility, Mode=OneWay}" Margin="0,4,0,0">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:ChartArtifactItem">
                                                                            <Border Margin="0,6" Background="{StaticResource CardSubtleBrush}" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                                                                                <Grid>
                                                                                    <Grid.RowDefinitions>
                                                                                        <RowDefinition Height="Auto"/>
                                                                                        <RowDefinition Height="Auto"/>
                                                                                        <RowDefinition Height="Auto"/>
                                                                                    </Grid.RowDefinitions>

                                                                                    <!-- 图表头部：标题与格式信息 -->
                                                                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                                            <Border Background="#E8E2D5" CornerRadius="4" Padding="5,2">
                                                                                                <TextBlock Text="分析图表" FontSize="10" FontWeight="Bold" Foreground="#382E24"/>
                                                                                            </Border>
                                                                                            <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                                                        </StackPanel>
                                                                                        <TextBlock HorizontalAlignment="Right" Text="{x:Bind FormattedSize}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                                                    </Grid>

                                                                                    <!-- 图表图片本体 (点击触发放大预览) -->
                                                                                    <Border Grid.Row="1" CornerRadius="8" Background="#FBF9F4" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" MaxHeight="320" Tag="{x:Bind}" PointerPressed="plotImage_PointerPressed" ToolTipService.ToolTip="点击全屏放大查看">
                                                                                        <Image Source="{x:Bind Bitmap}" Stretch="Uniform" HorizontalAlignment="Center"/>
                                                                                    </Border>

                                                                                    <!-- 底部操作按钮栏 -->
                                                                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0" HorizontalAlignment="Right">
                                                                                        <Button Click="btnViewPlotLarge_Click" Tag="{x:Bind}" Content="🔍 放大" Padding="8,4" CornerRadius="6" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" FontSize="10" ToolTipService.ToolTip="全屏放大查看高清图表"/>
                                                                                        <Button Click="btnCopyPlot_Click" Tag="{x:Bind}" Content="📋 复制" Padding="8,4" CornerRadius="6" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" FontSize="10" ToolTipService.ToolTip="复制图片到剪贴板"/>
                                                                                        <Button Click="btnSavePlotAs_Click" Tag="{x:Bind}" Content="💾 另存为" Padding="8,4" CornerRadius="6" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" FontSize="10" ToolTipService.ToolTip="将图表保存到本地"/>
                                                                                        <Button Click="btnPinToPlotDashboard_Click" Tag="{x:Bind}" Content="📊 固定到看板" Padding="8,4" CornerRadius="6" Background="{StaticResource AccentWarmBrush}" Foreground="White" FontSize="10" ToolTipService.ToolTip="推送到可视化分析看板"/>
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <!-- 底部操作栏：导出研报与复制 -->
                                                                <Grid Margin="0,4,0,0">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                                        <Button Click="btnExportMessageReport_Click" Tag="{x:Bind}" Content="📄 导出研报" Padding="8,3" CornerRadius="6" Background="{StaticResource CardSubtleBrush}" BorderBrush="{StaticResource BorderMutedBrush}" FontSize="10" ToolTipService.ToolTip="将此研报与内嵌图表一键导出为 Word 或 Markdown"/>
                                                                        <Button Click="btnCopyMessageContent_Click" Tag="{x:Bind}" Content="📋 复制回答" Padding="8,3" CornerRadius="6" Background="{StaticResource CardSubtleBrush}" BorderBrush="{StaticResource BorderMutedBrush}" FontSize="10" ToolTipService.ToolTip="复制纯文本内容"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- 快捷分析建议 Pills -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                                    <Button Click="btnQuickPrompt_Click" Tag="请对当前文档的核心内容进行要点总结，提炼 3 个关键观点。" Content="总结要点" Padding="10,4" FontSize="11" CornerRadius="14" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}"/>
                                    <Button Click="btnQuickPrompt_Click" Tag="请提取文档中的关键数据与统计指标，并以 Markdown 表格输出。" Content="提取数据表格" Padding="10,4" FontSize="11" CornerRadius="14" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}"/>
                                    <Button Click="btnQuickPrompt_Click" Tag="请分析该文档中可能存在的关键风险点和应对策略。" Content="风险分析" Padding="10,4" FontSize="11" CornerRadius="14" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}"/>
                                </StackPanel>

                                <!-- 输入区卡片（【模型选择放置在右下角发送按钮左侧】） -->
                                <Border Grid.Row="3" Background="{StaticResource CardBgBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 多行提问输入框 (使用 PreviewKeyDown 拦截 Enter 发送与 Shift+Enter 换行) -->
                                        <TextBox x:Name="tbQuestion" Grid.Row="0" PlaceholderText="输入你的数据分析或问答需求 (Enter 发送)..." AcceptsReturn="True" Height="70" BorderThickness="0" CornerRadius="8" Background="Transparent" FontSize="13" PreviewKeyDown="tbQuestion_PreviewKeyDown"/>

                                        <!-- 底部操作栏：左侧换行提示与AI状态，右侧为模型选择下拉框 + 发送/停止按钮 -->
                                        <Grid Grid.Row="1" Margin="0,6,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="Shift+Enter 换行，Enter 发送" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="tbChatRunStatus" Text="" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentWarmBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- 【模型选择放置在右下角发送按钮左侧】 -->
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <!-- 模型选择下拉控件 -->
                                                <ComboBox x:Name="cbQuickModel" SelectionChanged="cbQuickModel_SelectionChanged" Height="32" Padding="8,4" CornerRadius="8" Background="{StaticResource WarmBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" ToolTipService.ToolTip="选择对话所使用的大语言模型">
                                                    <ComboBoxItem Content="gpt-4o" IsSelected="True"/>
                                                    <ComboBoxItem Content="gpt-4o-mini"/>
                                                    <ComboBoxItem Content="claude-3-5-sonnet"/>
                                                    <ComboBoxItem Content="deepseek-chat"/>
                                                    <ComboBoxItem Content="deepseek-reasoner"/>
                                                    <ComboBoxItem Content="qwen3.7-flash"/>
                                                </ComboBox>

                                                <!-- 发送按钮 -->
                                                <Button x:Name="btnSend" Click="btnSend_Click" Height="32" Padding="16,0" Content="发送" FontWeight="Medium" FontSize="12" Background="{StaticResource AccentWarmBrush}" Foreground="White" CornerRadius="8"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 半透明遮罩层 (点击任意空白处收起抽屉，不遮挡左侧极窄导航栏) -->
                    <Border x:Name="drawerBackdrop" Background="#26000000" Visibility="Collapsed" PointerPressed="drawerBackdrop_PointerPressed"/>

                    <!-- ==================== 左侧弹出抽屉面板 (支持文档库与历史会话直接秒切) ==================== -->
                    <Border x:Name="borderDrawerPane" HorizontalAlignment="Left" Width="360" Margin="10,10,4,12" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" CornerRadius="14" Visibility="Collapsed">
                            <Grid>
                                <!-- ==================== 抽屉内容 1: 本地文档库 ==================== -->
                                <Grid x:Name="paneDocLibrary" Margin="12,14,12,12" Visibility="Visible">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 抽屉标题与关闭按钮 -->
                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="本地文档库" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="tbDocCount" Text="0 个文件" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <!-- 关闭抽屉按钮 -->
                                        <Button Click="btnCloseDocPane_Click" HorizontalAlignment="Right" Content="✕" Padding="6,3" Background="Transparent" BorderThickness="0" CornerRadius="6" Foreground="{StaticResource TextSecondaryBrush}" ToolTipService.ToolTip="收起文档库"/>
                                    </Grid>

                                    <!-- 视角切换分段栏：【📚 文档组】 / 【📄 工作区文档】 -->
                                    <Border Grid.Row="1" Margin="0,10,0,10" Background="#E8E2D5" CornerRadius="8" Padding="3">
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="btnViewDocGroups" Click="btnViewDocGroups_Click" Grid.Column="0" Content="📚 文档组管理" HorizontalAlignment="Stretch" Padding="0,5" Background="{StaticResource CardBgBrush}" CornerRadius="6" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <Button x:Name="btnViewAllDocs" Click="btnViewAllDocs_Click" Grid.Column="1" Content="📄 工作区文档" HorizontalAlignment="Stretch" Padding="0,5" Background="Transparent" CornerRadius="6" BorderThickness="0" FontSize="11" FontWeight="Normal" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Grid>
                                    </Border>

                                    <!-- 主列表展示区域 -->
                                    <Grid Grid.Row="2">
                                        <!-- 视角 A: 文档组管理视图 -->
                                        <Grid x:Name="gridDocGroupView" Visibility="Visible">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- 操作栏：新建组 + 打包当前 -->
                                            <Grid Grid.Row="0" Margin="0,0,0,10" ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="btnCreateNewGroup" Click="btnCreateNewGroup_Click" Grid.Column="0" HorizontalAlignment="Stretch" Padding="0,7" Background="{StaticResource AccentWarmBrush}" Foreground="White" CornerRadius="8">
                                                    <TextBlock Text="＋ 新建文档组" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center"/>
                                                </Button>
                                                <Button x:Name="btnPackCurrentDocsToGroup" Click="btnPackCurrentDocsToGroup_Click" Grid.Column="1" HorizontalAlignment="Stretch" Padding="0,7" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" CornerRadius="8" ToolTipService.ToolTip="将当前已载入工作区的文件打包为新组">
                                                    <TextBlock Text="📦 打包当前文件" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                </Button>
                                            </Grid>

                                            <!-- 文档组空状态 -->
                                            <StackPanel x:Name="spEmptyGroups" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Visibility="Collapsed">
                                                <TextBlock Text="暂无文档组" FontWeight="Medium" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="点击上方【新建文档组】开始批量管理" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- 文档组列表 -->
                                            <ListView Grid.Row="1" x:Name="lvDocumentGroups" SelectionChanged="lvDocumentGroups_SelectionChanged" SelectionMode="Single">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:DocumentGroup">
                                                        <Border Margin="0,3" Padding="10,8" Background="{StaticResource CardBgBrush}" CornerRadius="10" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- 图标徽章 -->
                                                                <Border Grid.Column="0" CornerRadius="6" Padding="6,4" VerticalAlignment="Center" Background="#D8CDBD">
                                                                    <TextBlock Text="📁" FontSize="11"/>
                                                                </Border>

                                                                <!-- 组信息 -->
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                                    <TextBlock Text="{x:Bind GroupName, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <Border Background="#EAE5D9" CornerRadius="4" Padding="4,1">
                                                                            <TextBlock Text="{x:Bind DocCountBadge, Mode=OneWay}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                        </Border>
                                                                        <TextBlock Text="{x:Bind FormattedLastActive, Mode=OneWay}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <!-- 操作按钮栏 -->
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                                    <Button Click="btnRenameGroup_Click" Tag="{x:Bind}" Padding="5,3" Background="Transparent" BorderThickness="0" CornerRadius="5" ToolTipService.ToolTip="重命名文档组">
                                                                        <TextBlock Text="✏️" FontSize="10"/>
                                                                    </Button>
                                                                    <Button Click="btnDeleteGroup_Click" Tag="{x:Bind}" Padding="5,3" Background="Transparent" BorderThickness="0" CornerRadius="5" ToolTipService.ToolTip="删除文档组">
                                                                        <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Grid>

                                        <!-- 视角 B: 工作区/全部文档视图 -->
                                        <Grid x:Name="gridAllDocsView" Visibility="Collapsed">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- 选择文件按钮 -->
                                            <StackPanel Grid.Row="0" Spacing="6">
                                                <Button x:Name="btnSelectFile" Click="btnSelectFile_Click" HorizontalAlignment="Stretch" Padding="0,9" Background="{StaticResource AccentWarmBrush}" Foreground="White" CornerRadius="10">
                                                    <TextBlock Text="选择本地文档 (多选导入)" FontWeight="Medium" FontSize="13" HorizontalAlignment="Center"/>
                                                </Button>
                                                <TextBlock Text="支持格式：PDF、Word、Excel、TXT、CSV、MD" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <!-- 搜索过滤框 -->
                                            <TextBox x:Name="tbSearchDoc" Grid.Row="1" Margin="0,8,0,8" PlaceholderText="搜索已载入文档..." TextChanged="tbSearchDoc_TextChanged" CornerRadius="10" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}"/>

                                            <!-- 文档列表 -->
                                            <Grid Grid.Row="2">
                                                <!-- 空状态提示 -->
                                                <StackPanel x:Name="spEmptyDocs" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Visibility="Visible">
                                                    <TextBlock Text="暂无导入文档" FontWeight="Medium" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="点击上方按钮添加本地文件" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- 列表视图 -->
                                                <ListView x:Name="lvDocuments" SelectionChanged="lvDocuments_SelectionChanged" SelectionMode="Single">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="models:DocumentItem">
                                                            <Border Margin="0,3" Padding="10,8" Background="{StaticResource CardBgBrush}" CornerRadius="10" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                                                                <Grid ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- 扩展名徽标 -->
                                                                    <Border Grid.Column="0" CornerRadius="6" Padding="6,3" VerticalAlignment="Center" Background="#D5CBB8">
                                                                        <TextBlock Text="{x:Bind ExtensionLabel, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#382E24"/>
                                                                    </Border>

                                                                    <!-- 文件信息与状态 -->
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="Medium" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <TextBlock Text="{x:Bind SummaryText, Mode=OneWay}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                            <!-- 丢失警告徽标 -->
                                                                            <Border Visibility="{x:Bind MissingBadgeVisibility, Mode=OneWay}" Background="#FEF3C7" CornerRadius="4" Padding="4,1">
                                                                                <TextBlock Text="⚠️ 文件丢失" FontSize="9" Foreground="#92400E" FontWeight="SemiBold"/>
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </StackPanel>

                                                                    <!-- 操作按钮栏：定位 + 移除 -->
                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                                        <!-- 仅丢失时显现的重新定位按钮 -->
                                                                        <Button Visibility="{x:Bind MissingBadgeVisibility, Mode=OneWay}" Click="btnRelocateDoc_Click" Tag="{x:Bind}" Padding="4,2" Background="Transparent" BorderThickness="0" CornerRadius="5" ToolTipService.ToolTip="源文件已移动，点击重新定位">
                                                                            <TextBlock Text="🔄" FontSize="10"/>
                                                                        </Button>
                                                                        <Button Click="btnRemoveDoc_Click" Tag="{x:Bind}" Padding="5,4" Background="Transparent" BorderThickness="0" CornerRadius="6" ToolTipService.ToolTip="从工作区移除">
                                                                            <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </Grid>
                                        </Grid>
                                    </Grid>

                                    <!-- 抽屉底部工具栏与备份迁移入口 -->
                                    <StackPanel Grid.Row="3" Margin="0,8,0,0" Spacing="6">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="btnExportBackup" Click="btnExportBackup_Click" Grid.Column="0" HorizontalAlignment="Stretch" Padding="6,6" CornerRadius="8" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" ToolTipService.ToolTip="将文档元数据、文档组与会话历史完整导出为 ZIP 备份包">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                                    <TextBlock Text="📤" FontSize="11"/>
                                                    <TextBlock Text="导出备份" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Medium"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="btnImportBackup" Click="btnImportBackup_Click" Grid.Column="1" HorizontalAlignment="Stretch" Padding="6,6" CornerRadius="8" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" ToolTipService.ToolTip="从 ZIP 备份包恢复文档库与历史会话">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                                    <TextBlock Text="📥" FontSize="11"/>
                                                    <TextBlock Text="导入恢复" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Medium"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <Border Padding="8,5" Background="{StaticResource CardBgBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                                            <TextBlock Text="选中文档组或文件后右侧将同步刷新预览与分析看板" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- ==================== 抽屉内容 2: 历史会话记录 (同样弹出模式) ==================== -->
                                <Grid x:Name="paneHistorySessions" Margin="12,14,12,12" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 标题、新建对话按钮与关闭按钮 -->
                                    <StackPanel Grid.Row="0" Spacing="8">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="历史对话记录" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock x:Name="tbHistoryCount" Text="0 个会话" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <!-- 关闭抽屉按钮 -->
                                            <Button Click="btnCloseDocPane_Click" HorizontalAlignment="Right" Content="✕" Padding="6,3" Background="Transparent" BorderThickness="0" CornerRadius="6" Foreground="{StaticResource TextSecondaryBrush}" ToolTipService.ToolTip="收起面板"/>
                                        </Grid>

                                        <!-- 新建会话按钮 -->
                                        <Button x:Name="btnNewChat" Click="btnNewChat_Click" HorizontalAlignment="Stretch" Padding="0,9" Background="{StaticResource AccentWarmBrush}" Foreground="White" CornerRadius="10">
                                            <TextBlock Text="新建对话会话" FontWeight="Medium" FontSize="13" HorizontalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>

                                    <!-- 搜索历史对话框 -->
                                    <TextBox x:Name="tbSearchHistory" Grid.Row="1" Margin="0,10,0,8" PlaceholderText="搜索历史对话..." TextChanged="tbSearchHistory_TextChanged" CornerRadius="10" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}"/>

                                    <!-- 历史会话列表 (支持海量条目滚动) -->
                                    <Grid Grid.Row="2">
                                        <!-- 空状态提示 -->
                                        <StackPanel x:Name="spEmptyHistory" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Visibility="Collapsed">
                                            <TextBlock Text="暂无历史对话" FontWeight="Medium" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="点击上方按钮发起新对话" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- 历史会话列表视图 -->
                                        <ListView x:Name="lvHistorySessions" SelectionChanged="lvHistorySessions_SelectionChanged" SelectionMode="Single">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:ChatSessionItem">
                                                    <Border Margin="0,3" Padding="10,8" Background="{StaticResource CardBgBrush}" CornerRadius="10" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- 会话绑定组徽标 (独立会话 vs 绑定组) -->
                                                            <Border Grid.Column="0" CornerRadius="6" Padding="6,3" VerticalAlignment="Center" Background="#EBE5D8">
                                                                <TextBlock Text="{x:Bind GroupBadgeText, Mode=OneWay}" FontSize="9" FontWeight="SemiBold" Foreground="#4A3F35" MaxWidth="64" TextTrimming="CharacterEllipsis"/>
                                                            </Border>

                                                            <!-- 会话标题与时间 -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="Medium" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{x:Bind FormattedLastActive, Mode=OneWay}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            </StackPanel>

                                                            <!-- 操作按钮：重命名 + 删除 -->
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                                <Button Click="btnRenameSession_Click" Tag="{x:Bind}" Padding="5,3" Background="Transparent" BorderThickness="0" CornerRadius="5" ToolTipService.ToolTip="重命名会话">
                                                                    <TextBlock Text="✏️" FontSize="10"/>
                                                                </Button>
                                                                <Button Click="btnDeleteSession_Click" Tag="{x:Bind}" Padding="5,4" Background="Transparent" BorderThickness="0" CornerRadius="6" ToolTipService.ToolTip="删除该会话">
                                                                    <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>

                                    <!-- 抽屉底部提示 -->
                                    <Border Grid.Row="3" Margin="0,8,0,0" Padding="8,6" Background="{StaticResource CardBgBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                                        <TextBlock Text="点击历史会话即可快速恢复对应上下文" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
            </Grid>

            <!-- 界面 2：设置二级界面 (参考用户截图 Master-Detail 布局：左侧目录栏 + 右侧具体卡片显示) -->
            <Grid x:Name="gridSettingsPage" Visibility="Collapsed" Background="{StaticResource WarmBgBrush}">
                <Grid.ColumnDefinitions>
                    <!-- 左侧设置目录栏 (宽度 220px) -->
                    <ColumnDefinition Width="220"/>
                    <!-- 中间分割边框 -->
                    <ColumnDefinition Width="1"/>
                    <!-- 右侧具体显示区 -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ==================== 左侧设置目录栏 ==================== -->
                <Border Grid.Column="0" Background="{StaticResource RailBgBrush}" Padding="16,16,12,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- 顶部“设置”大标题与返回按钮 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 搜索框 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 目录项列表（从上往下依次：LLM配置、Skill、关于我们） -->
                            <RowDefinition Height="*"/>
                            <!-- 底部操作提示 -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 顶部标题与返回看板按钮 -->
                        <Grid Grid.Row="0" Margin="2,0,0,14">
                            <TextBlock Text="设置" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="btnBackToMain" Click="btnBackToMain_Click" HorizontalAlignment="Right" Padding="8,4" Background="Transparent" BorderThickness="0" CornerRadius="6" ToolTipService.ToolTip="返回主工作区看板">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="←" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="看板" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 搜索框 (对齐截图风格) -->
                        <TextBox x:Name="tbSettingsSearch" Grid.Row="1" Margin="0,0,0,14" PlaceholderText="搜索..." TextChanged="tbSettingsSearch_TextChanged" CornerRadius="8" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" FontSize="12" Padding="8,6"/>

                        <!-- 目录项列表（从上往下依次：LLM配置；Skill；关于我们） -->
                        <StackPanel Grid.Row="2" Spacing="4">
                            <TextBlock Text="功能配置" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="6,0,0,4"/>

                            <!-- 1. LLM配置 (默认选中高亮) -->
                            <Button x:Name="btnSettingsNavLlm" Click="btnSettingsNavLlm_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,9" CornerRadius="8" Background="{StaticResource CardBgBrush}" BorderThickness="0">
                                <TextBlock x:Name="tbSettingsNavLlmText" Text="LLM配置" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </Button>

                            <!-- 2. Skill -->
                            <Button x:Name="btnSettingsNavSkill" Click="btnSettingsNavSkill_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,9" CornerRadius="8" Background="Transparent" BorderThickness="0">
                                <TextBlock x:Name="tbSettingsNavSkillText" Text="Skill" FontSize="13" FontWeight="Normal" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </Button>

                            <!-- 3. 关于我们 -->
                            <Button x:Name="btnSettingsNavAbout" Click="btnSettingsNavAbout_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,9" CornerRadius="8" Background="Transparent" BorderThickness="0">
                                <TextBlock x:Name="tbSettingsNavAboutText" Text="关于我们" FontSize="13" FontWeight="Normal" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>

                        <!-- 底部快捷保存提示 -->
                        <Border Grid.Row="3" Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="10,8" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                            <StackPanel Spacing="3">
                                <TextBlock Text="提示" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentWarmBrush}"/>
                                <TextBlock Text="参数配置实时保存在本地，重启应用不丢失。" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 分割线 -->
                <Border Grid.Column="1" Background="{StaticResource BorderMutedBrush}"/>

                <!-- ==================== 右侧具体显示区 (对称居中布局，自适应各屏幕尺寸) ==================== -->
                <ScrollViewer Grid.Column="2" Padding="32,28,32,32" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center">
                    <Grid HorizontalAlignment="Center" Width="880" MaxWidth="880">

                        <!-- ========== 1. LLM配置 具体显示 ========== -->
                        <StackPanel x:Name="viewSettingsLlm" Visibility="Visible" Spacing="22">
                            <!-- 页面大标题 -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="LLM配置" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="配置大语言模型接口密钥、服务商端点、推理超参数及专家人设" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- 反馈提示条 InfoBar -->
                            <InfoBar x:Name="infoBarSettings" IsOpen="False" Severity="Success" Title="配置已保存" Message="所有大模型连接参数与超参数已持久化保存。" CornerRadius="10"/>

                            <!-- 分组 1: 模型连接与认证 -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="模型连接与认证" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,0"/>
                                <Border Background="{StaticResource CardBgBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" Padding="20,16">
                                    <StackPanel Spacing="16">
                                        <!-- 条目 1: API Key -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="360"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                <TextBlock Text="API Key (密钥)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="用于访问大模型接口的授权秘钥，密钥在本地加密存储" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <PasswordBox x:Name="pbApiKey" Grid.Column="1" PlaceholderText="sk-..." CornerRadius="8" BorderBrush="{StaticResource BorderMutedBrush}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="#EDE8DD"/>

                                        <!-- 条目 2: Base URL -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="360"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                <TextBlock Text="模型接口地址 (Base URL)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="兼容 OpenAI 标准协议的端点地址（支持自建或中转服务）" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox x:Name="tbBaseUrl" Grid.Column="1" PlaceholderText="https://api.openai.com/v1" Text="https://api.openai.com/v1" CornerRadius="8" BorderBrush="{StaticResource BorderMutedBrush}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="#EDE8DD"/>

                                        <!-- 条目 3: 默认模型与动态获取按钮 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="360"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                <TextBlock Text="默认模型名称 (Model)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="选择或点击右侧按钮拉取当前 API Key 可调用的模型" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="cbModelName" Grid.Column="0" IsEditable="True" HorizontalAlignment="Stretch" CornerRadius="8" BorderBrush="{StaticResource BorderMutedBrush}" Margin="0,0,8,0">
                                                    <ComboBoxItem Content="gpt-4o" IsSelected="True"/>
                                                    <ComboBoxItem Content="gpt-4o-mini"/>
                                                    <ComboBoxItem Content="claude-3-5-sonnet"/>
                                                    <ComboBoxItem Content="deepseek-chat"/>
                                                    <ComboBoxItem Content="deepseek-reasoner"/>
                                                    <ComboBoxItem Content="qwen3.7-flash"/>
                                                </ComboBox>
                                                <Button x:Name="btnFetchModels" Click="btnFetchModels_Click" Grid.Column="1" Content="获取" Padding="12,6" CornerRadius="8" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" FontSize="12" ToolTipService.ToolTip="根据当前 API Key 和 Base URL 获取可用模型列表"/>
                                            </Grid>
                                        </Grid>

                                        <Border Height="1" Background="#EDE8DD"/>

                                        <!-- 条目 4: 连通性测试 (对齐右侧 360 列) -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="360"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                <TextBlock Text="接口网络测试" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="验证当前 API Key 与 Base URL 的连通状态" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <Button x:Name="btnTestApi" Click="btnTestApi_Click" Grid.Column="1" HorizontalAlignment="Right" Content="测试 API 连通性" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" CornerRadius="8" Padding="16,6" FontSize="12" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 分组 2: 推理与上下文超参数 -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="推理与上下文超参数" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,0"/>
                                <Border Background="{StaticResource CardBgBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" Padding="20,16">
                                    <StackPanel Spacing="16">
                                        <!-- 条目 1: 单次最大生成长度 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="360"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                <TextBlock Text="单次最大生成长度 (Max Output Tokens)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="控制大模型单次回答的最大生成 Token 限制，主流大模型（如 GPT-4o、DeepSeek）通常支持 4,096 ~ 8,192" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <Border Background="{StaticResource SidebarBgBrush}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right">
                                                    <TextBlock x:Name="tbContextLengthValue" Text="4,096 tokens" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentWarmBrush}"/>
                                                </Border>
                                                <Slider x:Name="sliderContextLength" Minimum="1024" Maximum="8192" StepFrequency="1024" Value="4096" ValueChanged="sliderContextLength_ValueChanged"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="#EDE8DD"/>

                                        <!-- 条目 2: 温度系数 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="360"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                <TextBlock Text="采样温度 (Temperature)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="较低值适合严谨的数据分析，较高值回答更具发散创造力" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <Border Background="{StaticResource SidebarBgBrush}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right">
                                                    <TextBlock x:Name="tbTemperatureValue" Text="0.7" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentWarmBrush}"/>
                                                </Border>
                                                <Slider x:Name="sliderTemperature" Minimum="0" Maximum="1.5" StepFrequency="0.1" Value="0.7" ValueChanged="sliderTemperature_ValueChanged"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 分组 3: 系统角色与提示词定制 -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="系统角色提示词 (System Prompt)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,0"/>
                                <Border Background="{StaticResource CardBgBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" Padding="20,16">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="定制伴读助手的专家人设、回答语言与数据分析格式约定：" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="tbSystemPrompt" AcceptsReturn="True" Height="85" TextWrapping="Wrap" CornerRadius="8" BorderBrush="{StaticResource BorderMutedBrush}" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 底部操作按钮栏 -->
                            <Grid Margin="0,4,0,0">
                                <Button Click="btnResetSettingsPage_Click" Content="恢复默认" Background="Transparent" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" CornerRadius="8" Padding="16,7" FontSize="12"/>
                                <Button Click="btnSaveSettingsPage_Click" Content="保存配置" HorizontalAlignment="Right" Background="{StaticResource AccentWarmBrush}" Foreground="White" CornerRadius="8" Padding="22,7" FontSize="12" FontWeight="Medium"/>
                            </Grid>
                        </StackPanel>

                        <!-- ========== 2. Skill 具体显示 ========== -->
                        <StackPanel x:Name="viewSettingsSkill" Visibility="Collapsed" Spacing="22">
                            <!-- 页面大标题 -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Skill" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="管理并接入标准 Skill 规范，发现本地已安装的技能插件（软件内置分析能力默认生效，不在此处罗列）" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- 反馈提示条 InfoBar -->
                            <InfoBar x:Name="infoBarSkillSettings" IsOpen="False" Severity="Success" Title="设置已生效" Message="技能配置已更新。" CornerRadius="10"/>

                            <!-- 分组 1: 已安装自定义扩展技能 (User Skills) -->
                            <StackPanel Spacing="8">
                                <Grid Margin="2,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="已安装自定义扩展技能 (User Skills)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="tbSkillsCountBadge" Text="0 个技能" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Button x:Name="btnImportSkill" Click="btnImportSkill_Click" Content="导入技能..." Padding="12,4" CornerRadius="6" Background="{StaticResource AccentWarmBrush}" Foreground="White" FontSize="11" ToolTipService.ToolTip="选择外部包含 SKILL.md 的技能文件夹一键导入"/>
                                        <Button x:Name="btnOpenSkillsFolder" Click="btnOpenSkillsFolder_Click" Content="打开技能目录" Padding="12,4" CornerRadius="6" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" FontSize="11" ToolTipService.ToolTip="在文件资源管理器中打开当前生效的应用技能主目录"/>
                                        <Button x:Name="btnRefreshSkills" Click="btnRefreshSkills_Click" Content="刷新列表" Padding="12,4" CornerRadius="6" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" FontSize="11" ToolTipService.ToolTip="重新扫描本地技能目录并更新"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{StaticResource CardBgBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" Padding="20,16">
                                    <StackPanel Spacing="12">
                                        <Grid>
                                            <!-- 空状态提示 -->
                                            <StackPanel x:Name="panelNoSkillsHint" Visibility="Collapsed" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,16">
                                                <TextBlock Text="未检测到已安装的自定义扩展 Skill" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="标准技能应为一个独立文件夹，根目录下包含带有 YAML Frontmatter 的 SKILL.md。&#x0a;默认技能存放于应用专属目录（%APPDATA%\DataAnalysis_Assistant\skills）或跨工具通用目录（~/.skills）。&#x0a;您可以点击下方按钮直接一键导入外部技能文件夹，或打开主目录手工放入技能包。" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520"/>
                                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                    <Button Click="btnImportSkill_Click" Content="一键导入技能文件夹..." Padding="14,6" CornerRadius="8" Background="{StaticResource AccentWarmBrush}" Foreground="White" FontSize="12"/>
                                                    <Button Click="btnOpenSkillsFolder_Click" Content="打开应用技能主目录" Padding="14,6" CornerRadius="8" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" FontSize="12"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- 动态技能列表 ItemsControl -->
                                            <ItemsControl x:Name="icInstalledSkills" ItemsSource="{x:Bind InstalledSkills}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:SkillItem">
                                                        <Grid Padding="0,10">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <Grid Grid.Row="0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- 左侧：技能名称、徽标与描述 -->
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4" Margin="0,0,16,0">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                        <Border Background="#E8E2D5" CornerRadius="4" Padding="6,2">
                                                                            <TextBlock Text="Skill" FontSize="10" FontWeight="Bold" Foreground="#382E24"/>
                                                                        </Border>
                                                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                        <TextBlock Text="{x:Bind FolderName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                                </StackPanel>

                                                                <!-- 右侧操作：定位文件夹按钮 + 启用/禁用 开关 (紧凑右对齐，消除多余空白) -->
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                    <Button Click="btnSkillOpenFolder_Click" Tag="{x:Bind DirectoryPath}" Content="目录" Padding="10,5" CornerRadius="6" Background="{StaticResource SidebarBgBrush}" BorderThickness="0" FontSize="11" ToolTipService.ToolTip="在资源管理器中打开此 Skill 目录"/>
                                                                    <ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=TwoWay}" Toggled="skillToggleSwitch_Toggled" Tag="{x:Bind Name}" MinWidth="0" Margin="0,0,-6,0" OnContent="" OffContent="" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- 分割线 -->
                                                            <Border Grid.Row="1" Height="1" Background="#EDE8DD" Margin="0,10,0,0"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>

                                        <!-- 分割线 -->
                                        <Border Height="1" Background="#EDE8DD" Margin="0,4,0,4"/>

                                        <!-- 条目: 自定义技能根目录路径 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="380"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                <TextBlock Text="自定义技能根目录 (可选)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="指定本地技能文件夹存放路径；若留空则自动使用应用专属目录与通用标准目录" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="tbCustomSkillsPath" Grid.Column="0" PlaceholderText="例如 D:\AI_Skills" CornerRadius="8" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <Button x:Name="btnBrowseSkillsPath" Click="btnBrowseSkillsPath_Click" Grid.Column="1" Content="浏览..." Padding="12,6" CornerRadius="8" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" FontSize="11" VerticalAlignment="Center" ToolTipService.ToolTip="浏览选择本地自定义技能文件夹"/>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                    <Button x:Name="btnResetSkillsPath" Click="btnResetSkillsPath_Click" Content="恢复默认" Padding="12,5" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource BorderMutedBrush}" FontSize="11"/>
                                                    <Button x:Name="btnApplySkillsPath" Click="btnApplySkillsPath_Click" Content="确定应用" Padding="16,5" CornerRadius="6" Background="{StaticResource AccentWarmBrush}" Foreground="White" FontSize="11" FontWeight="Medium"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 分组 2: 本地 Python 沙盒与安全执行引擎 (CodeAct Engine) -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="本地 Python 沙盒与安全执行引擎 (CodeAct Engine)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,0"/>
                                <Border Background="{StaticResource CardBgBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" Padding="20,16">
                                    <StackPanel Spacing="16">
                                        <!-- 条目 1: 运行时环境状态与检测 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="380"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                <TextBlock Text="Python 解释器环境" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock x:Name="tbPythonStatusDetail" Text="正在检测本地 Python 运行环境..." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" x:Name="btnRefreshPythonEnv" Click="btnRefreshPythonEnv_Click" HorizontalAlignment="Right" Content="重新检测" Padding="14,6" CornerRadius="8" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="#EDE8DD"/>

                                        <!-- 条目 2: 数据分析科学库就绪诊断 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="380"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                <TextBlock Text="核心科学库就绪状态" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="模型进行全量数据演算与绘图依赖的数据科学包" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Border x:Name="badgePandas" Background="#E8E2D5" CornerRadius="6" Padding="8,3">
                                                    <TextBlock x:Name="tbBadgePandas" Text="Pandas" FontSize="10" FontWeight="SemiBold" Foreground="#382E24"/>
                                                </Border>
                                                <Border x:Name="badgeMatplotlib" Background="#E8E2D5" CornerRadius="6" Padding="8,3">
                                                    <TextBlock x:Name="tbBadgeMatplotlib" Text="Matplotlib" FontSize="10" FontWeight="SemiBold" Foreground="#382E24"/>
                                                </Border>
                                                <Border x:Name="badgeNumpy" Background="#E8E2D5" CornerRadius="6" Padding="8,3">
                                                    <TextBlock x:Name="tbBadgeNumpy" Text="Numpy" FontSize="10" FontWeight="SemiBold" Foreground="#382E24"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="#EDE8DD"/>

                                        <!-- 条目 3: 安全刹车策略 (Safety Gate) -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="380"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                <TextBlock Text="代码安全审批策略 (Safety Gate)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="严格审批：每次执行均确认；智能拦截：仅高危系统指令需确认" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" x:Name="comboPythonSecurityMode" SelectionChanged="comboPythonSecurityMode_SelectionChanged" HorizontalAlignment="Stretch" VerticalAlignment="Center" CornerRadius="8" FontSize="12">
                                                <ComboBoxItem Content="智能拦截 (仅高危/写操作需确认)"/>
                                                <ComboBoxItem Content="严格确认 (每次代码执行均需审批)"/>
                                                <ComboBoxItem Content="自动放行 (信任本地执行)"/>
                                            </ComboBox>
                                        </Grid>

                                        <Border Height="1" Background="#EDE8DD"/>

                                        <!-- 条目 4: 自定义 Python 解释器路径 (带浏览与确定应用按钮) -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="380"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                <TextBlock Text="自定义 Python 路径 (可选)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="选择本地 python.exe 解释器，点击【确定应用】立即生效；若留空则自动检测 PATH" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="tbCustomPythonPath" Grid.Column="0" PlaceholderText="例如 D:\SoftWare\python\python.exe" CornerRadius="8" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <Button x:Name="btnBrowsePythonPath" Click="btnBrowsePythonPath_Click" Grid.Column="1" Content="浏览..." Padding="12,6" CornerRadius="8" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderMutedBrush}" FontSize="11" VerticalAlignment="Center" ToolTipService.ToolTip="浏览选择本地 python.exe 可执行文件"/>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                    <Button x:Name="btnResetPythonPath" Click="btnResetPythonPath_Click" Content="重置默认" Padding="12,5" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource BorderMutedBrush}" FontSize="11"/>
                                                    <Button x:Name="btnApplyPythonPath" Click="btnApplyPythonPath_Click" Content="确定应用" Padding="16,5" CornerRadius="6" Background="{StaticResource AccentWarmBrush}" Foreground="White" FontSize="11" FontWeight="Medium"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 底部操作按钮栏 -->
                            <Grid Margin="0,4,0,0">
                                <Button Click="btnResetSettingsPage_Click" Content="恢复默认" Background="Transparent" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" CornerRadius="8" Padding="16,7" FontSize="12"/>
                                <Button Click="btnSaveSettingsPage_Click" Content="保存配置" HorizontalAlignment="Right" Background="{StaticResource AccentWarmBrush}" Foreground="White" CornerRadius="8" Padding="22,7" FontSize="12" FontWeight="Medium"/>
                            </Grid>
                        </StackPanel>

                        <!-- ========== 3. 关于我们 具体显示 ========== -->
                        <StackPanel x:Name="viewSettingsAbout" Visibility="Collapsed" Spacing="22">
                            <!-- 页面大标题与品牌标语 -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="关于我们" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="AI 数据分析与文档伴读桌面客户端产品信息与架构说明" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- 品牌形象 Hero 卡片 -->
                            <Border Background="{StaticResource CardBgBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" Padding="20,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 软件专属品牌徽标 -->
                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="#F5F0E6" Margin="0,0,16,0" VerticalAlignment="Center" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                                        <Image x:Name="imgAboutLogo" Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- 产品名称与定位 -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Text="DataAnalysis Assistant" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <Border Background="#E8E2D5" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock Text="正式发布版" FontSize="10" FontWeight="SemiBold" Foreground="#382E24"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="面向本地多文档解析与 LLM 智能数据推演的 Windows 伴读看板" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- 顶部快速操作组 -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button x:Name="btnCheckUpdate" Click="btnCheckUpdate_Click" Content="检查更新" Padding="14,6" CornerRadius="8" Background="{StaticResource AccentWarmBrush}" Foreground="White" FontSize="11" FontWeight="Medium" ToolTipService.ToolTip="检查当前客户端版本发布状态"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 分组 1: 产品规格与环境信息 -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="产品规格与运行架构" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,0"/>
                                <Border Background="{StaticResource CardBgBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" Padding="20,16">
                                    <StackPanel Spacing="14">
                                        <!-- 条目 1: 客户端版本 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                <TextBlock Text="当前软件版本" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="正式生产发布版本号及构建发行基线" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#E8E2D5" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock Text="v1.3.0 (2026.10)" FontWeight="Bold" FontSize="11" Foreground="#382E24"/>
                                            </Border>
                                        </Grid>

                                        <Border Height="1" Background="#EDE8DD"/>

                                        <!-- 条目 2: 底层运行时架构 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                <TextBlock Text="底层运行时架构" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="基于微软 Windows App SDK 与 WinUI 3 现代化原生技术栈构建" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text=".NET 8.0 / WinUI 3 (x64)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="#EDE8DD"/>

                                        <!-- 条目 3: 核心执行范式与沙盒 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                <TextBlock Text="Agentic 执行范式与安全" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="支持 ReAct / CodeAct 双模自主推演调度，并受 Safety Gate 强约束沙盒保护" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#FEF3C7" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock Text="CodeAct 沙盒已就绪" FontSize="11" FontWeight="SemiBold" Foreground="#92400E"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 分组 2: 团队与开源许可 -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="团队与许可协议" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,0"/>
                                <Border Background="{StaticResource CardBgBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" Padding="20,16">
                                    <StackPanel Spacing="14">
                                        <!-- 条目 1: 开发者与团队 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                <TextBlock Text="开发者与维护团队" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="© 2026 Data Analysis Assistant Team. 保留所有权利。" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="Data Analysis Team" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="#EDE8DD"/>

                                        <!-- 条目 2: 开源协议 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                <TextBlock Text="开源许可协议" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="遵循 MIT 宽松开放源代码许可证，支持自由代码审计与生态集成" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="MIT License" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentWarmBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 底部系统诊断与快速操作栏 -->
                            <Grid Margin="0,4,0,0">
                                <Button x:Name="btnCopyDiagnosticInfo" Click="btnCopyDiagnosticInfo_Click" Content="📋 复制系统诊断信息" Background="Transparent" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" CornerRadius="8" Padding="16,7" FontSize="12" ToolTipService.ToolTip="复制当前软件版本、系统环境与运行时配置到剪贴板，方便故障反馈"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ==================== 全局高清图表全屏放大查看模态图层 ==================== -->
        <Grid x:Name="gridPlotImageViewer" Background="#CC000000" Visibility="Collapsed" Canvas.ZIndex="999">
            <Grid Margin="32,24" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="1100" MaxHeight="800">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 弹窗顶栏 -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock x:Name="tbViewerPlotTitle" Text="高清图表查看器" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock x:Name="tbViewerPlotInfo" Text="" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Click="btnClosePlotViewer_Click" Content="✕ 关闭" HorizontalAlignment="Right" Padding="12,5" CornerRadius="6" Background="#33FFFFFF" Foreground="White" BorderThickness="0" FontSize="12"/>
                </Grid>

                <!-- 高清大图卡片 -->
                <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="12" Padding="12" BorderBrush="#44FFFFFF" BorderThickness="1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image x:Name="imgViewerLargePlot" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ScrollViewer>
                </Border>

                <!-- 底部操作按钮 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Click="btnViewerCopy_Click" Content="📋 复制图片" Padding="14,6" CornerRadius="8" Background="#33FFFFFF" Foreground="White" BorderThickness="0" FontSize="12"/>
                    <Button Click="btnViewerSaveAs_Click" Content="💾 另存为..." Padding="14,6" CornerRadius="8" Background="{StaticResource AccentWarmBrush}" Foreground="White" BorderThickness="0" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>

